{
  "name": "nexus",
  "private": true,
  "description": "Run Prisma/seed from this folder — schema lives in backend/",
  "scripts": {
    "migrate:deploy": "npm --prefix backend run migrate:deploy",
    "db:setup": "npm --prefix backend run db:setup",
    "db:seed": "npm --prefix backend run db:seed",
    "prisma:seed": "npm --prefix backend run prisma:seed"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "node backend/prisma/seed.js"
  }
}
